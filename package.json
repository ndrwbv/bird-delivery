{
  "name": "bird-pizza-delivery",
  "productName": "Bird Pizza Delivery",
  "version": "0.1.0",
  "description": "Аркадная доставка пиццы по Москве. Бандлы: web (dev), yandex (Яндекс Игры), steam (Electron).",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "sandbox": "vite --port 5193 --mode web --open /sandbox.html",
    "ui": "vite --port 5194 --mode web --open /ui.html",
    "editor": "vite --port 5195 --mode web --open /editor.html",
    "dev:yandex": "vite --port 5191 --strictPort --mode yandex",
    "dev:steam": "vite --port 5192 --strictPort --mode steam",
    "build:web": "vite build --mode web",
    "build:yandex": "vite build --mode yandex && node tools/zip-yandex.mjs",
    "build:steam": "vite build --mode steam",
    "electron": "npm run build:steam && electron .",
    "dist:mac": "npm run build:steam && electron-builder --mac",
    "dist:win": "npm run build:steam && electron-builder --win zip --x64",
    "dist:deck": "npm run build:steam && electron-builder --linux dir --x64 && node tools/pack-deck.mjs",
    "mapcheck": "node tools/mapcheck.mjs",
    "i18n:extract": "node tools/i18n-extract.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "sfx": "node tools/sfx-gen.mjs",
    "sfx:index": "node tools/sfx-index.mjs",
    "probe": "electron tools/probe.cjs",
    "check": "node tools/check.cjs",
    "media": "npm run build:yandex && for l in ru en es; do electron tools/capture.cjs --lang=$l && electron tools/capture.cjs --lang=$l --mobile && electron tools/capture.cjs --lang=$l --video; done && node tools/media-post.mjs"
  },
  "build": {
    "appId": "ru.ndrwbv.birdpizza",
    "productName": "BirdPizza",
    "files": [
      "dist/steam/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "shortcutName": "Птица Пицца",
      "uninstallDisplayName": "Птица Пицца",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "bird-pizza-setup.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "executableName": "bird-pizza"
    },
    "asarUnpack": [
      "node_modules/steamworks.js/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron": true
  },
  "optionalDependencies": {
    "koffi": "3.3.1",
    "steamworks.js": "^0.4.0"
  }
}
