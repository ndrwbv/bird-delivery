config_version=5

[application]
config/name="Птица Пицца — Юг"
config/icon="res://assets/icon.png"
run/main_scene="res://south_drive.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.09, 0.13, 0.12, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=1

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.72, 0.80, 0.77, 1)

[input]

accelerate={
"deadzone":0.08,
"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}
reverse={
"deadzone":0.08,
"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
steer_left={
"deadzone":0.16,
"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
steer_right={
"deadzone":0.16,
"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
handbrake={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":1)]
}
deliver={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":0)]
}
reset_car={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":2)]
}
nitro={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194325), Object(InputEventKey,"physical_keycode":78), Object(InputEventJoypadButton,"button_index":9)]
}
