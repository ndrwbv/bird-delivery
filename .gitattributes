# The prepared-land source key hashes the same LF text bytes built on every OS.
src/**/*.js text eol=lf
src/**/*.mjs text eol=lf
src/**/*.cjs text eol=lf
src/**/*.json text eol=lf
src/**/*.css text eol=lf
src/**/*.svg text eol=lf
src/**/*.txt text eol=lf
src/**/*.glsl text eol=lf
src/**/*.vert text eol=lf
src/**/*.frag text eol=lf
src/**/*.html text eol=lf
src/**/*.md text eol=lf
vite.config.js text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
tools/land-package-*.mjs text eol=lf
tools/land-package-*.cjs text eol=lf
# Unified patch context includes a mandatory space on empty context lines.
docs/measurements/**/*.patch -whitespace
# Raw tool output is kept byte-exact, including its original trailing spaces.
docs/measurements/**/*.log -whitespace
